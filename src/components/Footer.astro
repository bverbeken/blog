---
import { AUTHOR } from '../consts';
---

<footer>
	<div>{AUTHOR} · <a href="https://github.com/bverbeken">GitHub</a> · <a href="https://www.linkedin.com/in/bverbeken">LinkedIn</a> · <a href="/rss.xml">RSS</a> · <a href="https://cloud.umami.is/share/Bm8SHU6MfJtJHmZb">Stats</a></div>
	<p>This site counts page views with Umami. It uses no cookies and stores nothing that identifies you.</p>
</footer>
<style>
	footer {
		max-width: var(--measure);
		margin: 0 auto;
		padding: 3em 1rem;
		color: var(--muted);
		font-size: 0.85em;
	}
	div {
		padding-top: 0.75em;
		border-top: 1px solid var(--rule);
	}
	p {
		margin: 0.5em 0 0;
	}
	div::before {
		content: '-- ';
		color: var(--accent);
	}
	a::before {
		content: '[';
	}
	a::after {
		content: ']';
	}
	footer a {
		color: inherit;
		text-decoration: none;
	}
	footer a:hover {
		color: var(--accent);
	}
</style>
