---
import { SITE_TITLE } from '../consts';
---

<header>
	<a class="title" href="/">{SITE_TITLE}</a>
</header>
<style>
	header {
		max-width: var(--measure);
		margin: 0 auto;
		padding: 2.5em 1em 0;
	}
	header > a {
		display: block;
		padding-bottom: 0.75em;
		border-bottom: 1px solid var(--rule);
		margin-bottom: 2.75em;
	}
	.title {
		font-weight: 600;
		color: var(--text);
		text-decoration: none;
	}
	.title::before {
		content: '~/';
		color: var(--muted);
		font-weight: 400;
	}
</style>
