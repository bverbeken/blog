---
import { SITE_TITLE } from '../consts';
---

<header>
	<a class="title" href="/">{SITE_TITLE}</a>
</header>
<style>
	header {
		max-width: var(--measure);
		margin: 0 auto;
		padding: 2.5em 1em 1.5em;
	}
	.title {
		font-weight: 700;
		font-size: 1.15em;
		color: var(--text);
		text-decoration: none;
	}
</style>
