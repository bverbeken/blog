---
interface Props {
	by: 'human' | 'assisted' | 'ai';
	withIcon?: boolean;
}

const KINDS = {
	human: { icon: '✍️', text: 'human-written' },
	assisted: { icon: '✍️+🤖', text: 'AI-assisted' },
	ai: { icon: '🤖', text: 'AI-written' },
};

const { by, withIcon = false } = Astro.props;
const { icon, text } = KINDS[by];
---

<span class="written-by">{withIcon && <span aria-hidden="true">{icon} </span>}<span class="text">{text}</span></span>
<style>
	.written-by {
		white-space: nowrap;
	}
	.text {
		color: var(--muted);
	}
</style>
