---
interface Props {
	by: 'human' | 'assisted' | 'ai';
	label?: boolean;
}

const KINDS = {
	human: {
		text: 'human-written',
		svg: '<circle cx="12" cy="8" r="4.5"/><path d="M4 22c0-4.5 3.6-7.5 8-7.5s8 3 8 7.5"/>',
	},
	assisted: {
		text: 'AI-assisted',
		svg: '<circle cx="7.5" cy="9.5" r="3.2"/><path d="M1.5 22c0-3.4 2.6-5.8 6-5.8 1.7 0 3.2.6 4.3 1.6"/><rect x="13" y="5.5" width="8" height="6.5" rx="1"/><path d="M17 5.5V3.5"/><circle class="dot" cx="15.6" cy="8.7" r=".4"/><circle class="dot" cx="18.4" cy="8.7" r=".4"/><path d="M11.5 22v-3.3c0-1.3 1-2.2 2.2-2.2h6.6c1.2 0 2.2.9 2.2 2.2V22"/>',
	},
	ai: {
		text: 'AI-written',
		svg: '<rect x="6.5" y="4" width="11" height="9" rx="1.5"/><path d="M12 4V1.8"/><circle class="dot" cx="10" cy="8.5" r=".5"/><circle class="dot" cx="14" cy="8.5" r=".5"/><path d="M4 22v-4a2.5 2.5 0 0 1 2.5-2.5h11A2.5 2.5 0 0 1 20 18v4"/>',
	},
};

const { by, label = false } = Astro.props;
const { svg, text } = KINDS[by];
---

<span class:list={["written-by", { tip: !label }]} data-tip={text} aria-label={text} tabindex={label ? undefined : 0}>
	<svg class="icon" viewBox="0 0 24 24" aria-hidden="true" set:html={svg} />{label && <span class="text"> {text}</span>}
</span>
<style>
	.written-by {
		white-space: nowrap;
		color: var(--muted);
	}
	.icon {
		width: 1.25em;
		height: 1.25em;
		vertical-align: -0.25em;
		fill: none;
		stroke: currentColor;
		stroke-width: 1.6;
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	.icon :global(.dot) {
		fill: currentColor;
	}
	.tip {
		position: relative;
		cursor: help;
	}
	.tip::after {
		content: attr(data-tip);
		position: absolute;
		left: 50%;
		bottom: 125%;
		transform: translateX(-50%);
		padding: 0.2em 0.5em;
		border-radius: 4px;
		background: var(--text, #222);
		color: var(--bg, #fff);
		font-size: 0.8em;
		white-space: nowrap;
		pointer-events: none;
		opacity: 0;
		transition: opacity 0.1s;
	}
	.tip:hover::after,
	.tip:focus::after {
		opacity: 1;
	}
</style>
