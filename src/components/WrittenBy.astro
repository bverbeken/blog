---
interface Props {
	by: 'human' | 'assisted' | 'ai';
	label?: boolean;
}

const KINDS = {
	human: { icon: '✍️', text: 'human-written' },
	assisted: { icon: '🤖+✍️', text: 'AI-assisted' },
	ai: { icon: '🤖', text: 'AI-written' },
};

const { by, label = false } = Astro.props;
const { icon, text } = KINDS[by];
---

<span class:list={["written-by", { tip: !label }]} data-tip={text} aria-label={text} tabindex={label ? undefined : 0}>
	<span aria-hidden="true">{icon}</span>{label && <span class="text"> {text}</span>}
</span>
<style>
	.written-by {
		white-space: nowrap;
	}
	.text {
		color: var(--muted);
	}
	/* Icon only: show the label on hover or focus */
	.tip {
		position: relative;
		cursor: help;
	}
	.tip::after {
		content: attr(data-tip);
		position: absolute;
		left: 50%;
		bottom: 125%;
		transform: translateX(-50%);
		padding: 0.2em 0.5em;
		border-radius: 4px;
		background: var(--text, #222);
		color: var(--bg, #fff);
		font-size: 0.8em;
		white-space: nowrap;
		pointer-events: none;
		opacity: 0;
		transition: opacity 0.1s;
	}
	.tip:hover::after,
	.tip:focus::after {
		opacity: 1;
	}
</style>
