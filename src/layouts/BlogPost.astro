---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import WrittenBy from '../components/WrittenBy.astro';

type Props = CollectionEntry<'blog'>['data'] & {
	readingMinutes: number;
	newer?: CollectionEntry<'blog'>;
	older?: CollectionEntry<'blog'>;
};

const { title, description, pubDate, updatedDate, heroImage, writtenBy, readingMinutes, newer, older } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={title} description={description} image={heroImage} article />
		<style>
			.meta {
				margin: 0 0 0.5em;
				color: var(--muted);
			}
			.label {
				margin: 0 0 2.5em;
				color: var(--muted);
				font-style: italic;
			}
			.info {
				margin-left: 0.25em;
				font-style: normal;
				text-decoration: none;
			}
			h1 {
				margin-bottom: 0.25em;
			}
			.hero {
				margin: 0 0 2em;
			}
			article :global(img:not(.hero)) {
				cursor: zoom-in;
			}
			.zoom {
				max-width: 100vw;
				max-height: 100vh;
				padding: 0;
				border: 0;
				background: none;
				outline: none;
				cursor: zoom-out;
			}
			.more {
				display: flex;
				justify-content: space-between;
				gap: 2em;
				margin-top: 4em;
				padding-top: 1.5em;
				border-top: 1px solid var(--rule);
			}
			.more > * {
				flex: 1 1 0;
			}
			.more .newer {
				text-align: right;
			}
			@media (max-width: 480px) {
				.more {
					flex-direction: column;
					gap: 1em;
				}
				.more .newer {
					text-align: left;
				}
			}
			:global(dialog.zoom::backdrop) {
				background: rgb(0 0 0 / 0.85);
			}
			.zoom img {
				display: block;
				max-width: 95vw;
				max-height: 95vh;
				width: auto;
				height: auto;
			}
		</style>
	</head>

	<body>
		<Header />
		<main>
			<article>
				<h1>{title}</h1>
				<p class="meta">
					<FormattedDate date={pubDate} /> · {readingMinutes} min read
					{
						updatedDate && (
							<>
								· updated <FormattedDate date={updatedDate} />
							</>
						)
					}
				</p>
				<p class="label">
					<WrittenBy by={writtenBy} label />
					{Astro.url.pathname !== '/blog/writing-with-ai/' && <a class="info" href="/blog/writing-with-ai/" title="What this means" aria-label="What this means">ⓘ</a>}
				</p>
				{heroImage && <Image class="hero" width={1280} src={heroImage} alt="" />}
				<slot />
			</article>
			{
				(older || newer) && (
					<nav class="more">
						{older ? (
							<a class="older" rel="prev" href={`/blog/${older.id}/`} data-umami-event="older-post">
								&lt;&lt; {older.data.title}
							</a>
						) : (
							<div />
						)}
						{newer && (
							<a class="newer" rel="next" href={`/blog/${newer.id}/`} data-umami-event="newer-post">
								{newer.data.title} &gt;&gt;
							</a>
						)}
					</nav>
				)
			}
			<dialog class="zoom"><img alt="" /></dialog>
		</main>
		<script>
			const zoom = document.querySelector<HTMLDialogElement>('dialog.zoom')!;
			const zoomed = zoom.querySelector('img')!;
			document.querySelectorAll<HTMLImageElement>('article img:not(.hero)').forEach((img) => {
				img.addEventListener('click', () => {
					zoomed.src = img.currentSrc || img.src;
					zoomed.alt = img.alt;
					zoom.showModal();
				});
			});
			zoom.addEventListener('click', () => zoom.close());
		</script>
		<Footer />
	</body>
</html>
